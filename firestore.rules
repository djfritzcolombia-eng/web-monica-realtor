rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /user/{userId} {
      allow read: if true;
      allow write: if false;
    }

    match /sessions/{sessionId} {
      allow create: if request.resource.data.sessionId == sessionId
                    && request.resource.data.visitorId is string;
      allow update: if resource.data.sessionId == sessionId;
      allow read: if true;

      match /events/{eventId} {
        allow create: if request.resource.data.sessionId == sessionId
                      && request.resource.data.type is string;
        allow read: if true;
        allow update, delete: if false;
      }
    }

    match /sell_listings/{listingId} {
      allow create: if request.resource.data.status == "pending"
                    && request.resource.data.ownerName is string
                    && request.resource.data.ownerEmail is string
                    && request.resource.data.ownerPhone is string
                    && request.resource.data.title is string
                    && request.resource.data.price is number;
      allow read: if true;
      allow update: if true;
      allow delete: if false;
    }

    match /credit_applications/{applicationId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.docNumber is string
                    && request.resource.data.applicantName is string;
      allow read: if true;
      allow update, delete: if false;
    }
  }
}
